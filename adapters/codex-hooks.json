{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_STATE__ --agent codex --state waiting --detail ready --adapter-version 3"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_STATE__ --agent codex --state busy --detail working --adapter-version 3"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_STATE__ --agent codex --state busy --detail working --adapter-version 3"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_STATE__ --agent codex --state busy --detail working --adapter-version 3"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_STATE__ --agent codex --state waiting --detail asking --adapter-version 3"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_STATE__ --agent codex --state waiting --detail done --adapter-version 3"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_STATE__ --agent codex --state waiting --detail done --adapter-version 3"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_STATE__ --clear --adapter-version 3"
          }
        ]
      }
    ]
  }
}
