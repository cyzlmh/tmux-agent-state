        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_STATE__ --agent claude --state busy --detail working --guard --adapter-version 1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_STATE__ --agent claude --state busy --detail working --guard --adapter-version 1"
          }
        ]
      }
    ],
    "PermissionRequest": [
